# hpc-mcp configuration — copy to /etc/hpc-mcp.env (or export in your shell)
# Every value below is the default; uncomment to change.

## Transport
#HPC_MCP_TRANSPORT=http            # http (streamable) or stdio
#HPC_MCP_HOST=0.0.0.0
#HPC_MCP_PORT=8765
#HPC_MCP_AUTH_TOKEN=               # empty = auth disabled; set to require Bearer token

## Tool groups (disable what the node can't serve)
#HPC_MCP_ENABLE_SLURM=1
#HPC_MCP_ENABLE_GPFS=1             # mm* commands: needs root + GPFS client
#HPC_MCP_ENABLE_ES=1
#HPC_MCP_ENABLE_PROM=1

## File access
#HPC_MCP_READ_ROOTS=/work          # comma-separated roots for log/script reads
#HPC_MCP_GPFS_DEVICE=gpfs

## Elasticsearch (generic index/log exploration)
#HPC_MCP_ES_URL=http://localhost:9200
#HPC_MCP_ES_USER=                  # optional basic auth
#HPC_MCP_ES_PASS=
#HPC_MCP_ES_VERIFY=1               # 0 = skip TLS verification
#HPC_MCP_ES_ALLOWED_INDICES=       # fnmatch patterns CSV (e.g. logs-*,slurm*); empty = all

## Prometheus (node exporter + DCGM GPU)
#HPC_MCP_PROM_URL=http://localhost:9090
#HPC_MCP_PROM_AUTH_FILE=~/.config/prometheus_pass   # "user:password"
#HPC_MCP_PROM_USER=
#HPC_MCP_PROM_PASS=
#HPC_MCP_PROM_VERIFY=1             # 0 = skip TLS verification (self-signed)

## Cluster semantics
#HPC_MCP_INTERACTIVE_PARTITIONS=visu   # CSV: partitions where idle jobs are normal
#HPC_MCP_MEM_RATIOS=               # override GB/CPU ratios, e.g. cpu:7.8,gpu:4.7

## Latency probes
#HPC_MCP_PROBE_LS_PATH=            # empty = first entry of HPC_MCP_READ_ROOTS
#HPC_MCP_PROBE_DNS_HOST=           # empty = DNS probe disabled

## Misc
#HPC_MCP_CMD_TIMEOUT=30
